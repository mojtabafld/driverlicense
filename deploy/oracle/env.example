# Teoripro's settings on the Oracle server: copied to /etc/teoripro/env by setup.sh; fill in the values there
# (the same values as in DigitalOcean's App-Level Environment Variables). One per line, NAME=value, no spaces around =.
# A value with spaces or quotes (the Google Play service account's JSON, on one line) goes in single quotes: NAME='...'.

# --- The database (Oracle Cloud, Autonomous Database) ---
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
# The «TLS» connection string from the database's page (Database connection), in one line, in single quotes.
ORACLE_CONNECT_STRING=
# Only when the database asks for mutual TLS (a wallet): the unzipped wallet's folder and its password.
#ORACLE_WALLET_DIR=/etc/teoripro/wallet
#ORACLE_WALLET_PASSWORD=

# --- The server ---
PORT=3000
HOST=127.0.0.1
TZ=Europe/Copenhagen
# The visitor's address, from the proxy in front (server.js clientIp): cf-connecting-ip behind a Cloudflare Tunnel,
# x-forwarded-for behind Caddy.
CLIENT_IP_HEADER=x-forwarded-for
PUBLIC_URL=https://teori.bitlane.app

# --- The rest, as in DigitalOcean (leave out the ones you do not use) ---
ADMIN_USERS=
DEFAULT_THEME=
ANTHROPIC_API_KEY=
LESSON_AI_MODEL=
SEARCH_AI_MODEL=
INSIGHTS_HOUR=
INSIGHTS_EMAIL=
INSIGHTS_MODEL=
IMAGE_PROMPT_MODEL=
IMAGE_MODEL=
KIE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DA_WOMAN=
ELEVENLABS_VOICE_ID_FA_MAN=
ELEVENLABS_MODEL=
ELEVENLABS_MODEL_FA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_GATE=
PREMIUM_PRICE_WEEK=
PREMIUM_PRICE_MONTH=
PREMIUM_PRICE_QUARTER=
PREMIUM_TESTERS=
PROMO_CODE=
PROMO_DAYS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
REPORT_TO=
FORWARD_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LATEST_APP_VERSION=
APP_DOWNLOAD_URL=
APP_DOWNLOAD_URL_PROVE=
INVITE_CODE=
